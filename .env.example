# Use ONE of the following (OpenAI is checked first if both are set).

# Official OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Or OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
